# Тестовый Gmail для входа на unicoplay.com по OTP-коду из письма.
# Скопируйте файл в .env и заполните. .env не попадает в git.

# Адрес тестового Gmail, на который зарегистрирован аккаунт Unico Play
TEST_EMAIL=

# Пароль приложения Google (16 букв, https://myaccount.google.com/apppasswords), пробелы можно оставить
GMAIL_APP_PASSWORD=
